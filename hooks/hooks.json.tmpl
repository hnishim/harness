{
  "description": "Codex session refresh, textlint, and citation-grounding hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 '__HOOKS_RUNTIME__/session_start_repo_refresh.py'",
            "timeout": 15,
            "statusMessage": "Refreshing repository remote state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 '__HOOKS_RUNTIME__/textlint-pretool-hook.py'",
            "timeout": 120,
            "statusMessage": "Notionへ渡す文章をtextlintで整えています"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 '__HOOKS_RUNTIME__/textlint-posttool-hook.py'",
            "timeout": 120,
            "statusMessage": "ローカル文章ファイルをtextlintで整えています"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 '__HOOKS_RUNTIME__/citation_grounding_stop.py'",
            "timeout": 40,
            "statusMessage": "引用元と回答を照合しています"
          }
        ]
      }
    ]
  }
}
